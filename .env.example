# ---- Required secrets ------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string
# 32 bytes as 64 hex characters. Generate with: openssl rand -hex 32
# Keep it safe: losing it makes stored contacts and messages unreadable.
ENCRYPTION_KEY=

# ---- Database --------------------------------------------------------------
POSTGRES_USER=legacy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=legacy_planner
# Used when running the backend outside Docker:
DATABASE_URL=postgres://legacy:change-me@localhost:5432/legacy_planner

# ---- App -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Region used to read phone numbers written without a + country code.
DEFAULT_PHONE_COUNTRY=US
JWT_EXPIRES_IN=12h

# ---- Notifications ---------------------------------------------------------
# Master switch. When false, scheduled runs wait and nothing is sent.
NOTIFICATIONS_ENABLED=true
# How often the background job checks for inactivity and due sends.
SCHEDULER_INTERVAL_MS=60000

# ---- Twilio (leave blank for mock mode: messages are logged, never sent) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
