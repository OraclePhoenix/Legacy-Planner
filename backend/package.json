{
  "name": "legacy-planner-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "make-admin": "node scripts/make-admin.js",
    "migrate": "node -e \"require('./src/db').migrate().then(()=>process.exit(0))\""
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "twilio": "^6.2.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
